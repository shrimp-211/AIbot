# ==================== QQ AI Agent 环境变量模板 ====================
# 复制为 .env 填入真实值;config.yaml 中用 ${ENV_VAR} / ${ENV_VAR:-default} 引用。
# .env 已被 gitignore,不会提交泄露密钥。

# ---------- LLM Provider(必填) ----------
# OpenAI 兼容 / Anthropic 的 API Key(对应 config.yaml: llm.provider.api_key)
LLM_API_KEY=sk-your-api-key-here

# 可选:OpenAI 兼容服务地址,如 DeepSeek https://api.deepseek.com/v1
# 对应 config.yaml: llm.provider.base_url
# LLM_BASE_URL=

# ---------- 联网搜索(可选,不配置则回退到 DuckDuckGo 免费接口) ----------
TAVILY_API_KEY=
BRAVE_API_KEY=

# ---------- WebUI 管理密码(可选,留空则首次启动随机生成并打印在日志) ----------
# WEBUI_PASSWORD=

# ---------- QQ 机器人账号(用于 @ 唤醒检测) ----------
# 对应各适配器配置段的 self_id
# QQ_SELF_ID=
